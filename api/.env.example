# ─── Agency Pay API — environment variables ──────────────────────────────────
# Copy to .env for local development; set the same keys in Vercel → Project →
# Settings → Environment Variables for production. Never commit real values.

# PostgreSQL (Neon / Supabase / Vercel Postgres / any managed Postgres).
# Pooled URL for the app; DIRECT_DATABASE_URL is used by migrations.
# If your provider gives only one URL, put the same value in both.
DATABASE_URL="postgresql://user:password@host:5432/agencypay?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/agencypay?sslmode=require"

# Admin PIN/password. Used ONLY to create the administrator on the very first
# login; afterwards the hashed value lives in the database (change it in Settings).
ADMIN_PASSWORD=""

# 1Pay — https://1pay.cx → Settings → API & webhooks.
# API key needs scopes payments:read + payments:write.
# pk_test_<prefix>.<secret> = test mode (no money moves), pk_<prefix>.<secret> = live.
ONEPAY_API_KEY=""
# "notifyUrl signing secret" for the SAME mode as the key:
# whsec_test_… for a test key, whsec_… for a live key (also GET /v1/me → webhookSecret).
ONEPAY_WEBHOOK_SECRET=""
# true  = checkout offers bank cards only (cryptoAssets: [])
# false = use the payment methods configured in your 1Pay account
ONEPAY_CARD_ONLY="true"
# Optional link back to your agency site shown on the 1Pay checkout page.
PAYMENT_REDIRECT_URL=""

# Public HTTPS origin of THIS API (used to build the webhook notifyUrl),
# e.g. https://agency-pay-api.vercel.app. On Vercel it falls back to the
# production domain automatically.
PUBLIC_API_URL=""

# Origins allowed to call the API from a browser (comma-separated), e.g. the
# GitHub Pages origin. Path is not part of an origin.
ALLOWED_ORIGINS="https://igorrodionov427-creator.github.io,http://localhost:3000"

# Shared secret for /api/cron/reconcile (Vercel Cron sends it automatically;
# the GitHub Actions reconcile workflow uses the same value). 32+ random chars.
CRON_SECRET=""

# Session lifetime: absolute days / idle days.
SESSION_TTL_DAYS="30"
SESSION_IDLE_DAYS="7"
